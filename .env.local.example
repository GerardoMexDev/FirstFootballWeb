# Plantilla. Copiar a  .secretos/.env  y completar con los valores reales.
# La carpeta .secretos/ entera está en .gitignore. La carga next.config.mjs y los scripts
# con  process.loadEnvFile('.secretos/.env').

# ════════════════════════════════════════════════════════════════════════════
#  EN VERCEL van SOLO estas 3 (las NEXT_PUBLIC_* + el dominio de login).
#  Se compilan dentro del build → si se cambia una, hay que re-deployar.
# ════════════════════════════════════════════════════════════════════════════

# --- Supabase (cliente: seguras de exponer al navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Dominio interno que la app agrega al nombre de login (sin @) ---
NEXT_PUBLIC_DOMINIO_LOGIN=footballfirst.uy

# ════════════════════════════════════════════════════════════════════════════
#  SOLO LOCAL / SERVIDOR — scripts y Edge Functions. NUNCA en Vercel ni en el
#  navegador. El service_role y el DB password saltan la RLS: acceso total.
# ════════════════════════════════════════════════════════════════════════════

# --- service_role de Supabase (seed-*.mjs) ---
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Password de la base (scripts/aplicar-migracion.mjs).
#     Dashboard > Project Settings > Database. ---
SUPABASE_DB_PASSWORD=<db-password>

# --- Access token personal de Supabase (para `supabase gen types` sin Docker).
#     https://supabase.com/dashboard/account/tokens ---
SUPABASE_ACCESS_TOKEN=<personal-access-token>

# --- API-Football (api-sports.io) — plan FREE (100 req/día).
#     Cuenta gratis en https://dashboard.api-football.com . Solo Edge Functions. ---
API_FOOTBALL_KEY=<api-key>
# THE_SPORTS_DB_KEY=3   # opcional; "3" es la key de prueba pública del plan free. ESPN/Wikidata no requieren key.
